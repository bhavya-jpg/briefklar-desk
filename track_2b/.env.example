# Required by the Hack Apertus template
LLM_NAME=apertus-8b                       # model name as served
LLM_BASE_URL=http://vllm:8000/v1          # local vLLM; or a Swiss-hosted endpoint
LLM_API_KEY=not-needed-for-local

# Briefklar
BRIEFKLAR_MODE=replay                     # replay | live
BRIEFKLAR_CANTON=BE                       # default canton for holidays (ISO 3166-2:CH code)
BRIEFKLAR_SESSION_TTL_MIN=120
BRIEFKLAR_MAX_PARALLEL_LETTERS=2
BRIEFKLAR_RECORD=0                        # 1 = also write model responses to data/replay (bench work only, never on real letters)
BRIEFKLAR_GUIDED_JSON=1                   # 0 if the vLLM fork rejects response_format json_schema
JUDGE_BASE_URL=                           # eval only (Apertus 70B)
JUDGE_API_KEY=
JUDGE_MODEL=apertus-70b

# vLLM image for `make gpu-up`. Pin the digest you pulled, e.g.
# VLLM_IMAGE=ghcr.io/swiss-ai/vllm_apertus_1.5_release@sha256:<digest>
VLLM_IMAGE=ghcr.io/swiss-ai/vllm_apertus_1.5_release:latest
